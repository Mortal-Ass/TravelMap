{$SITE_ADDRESS:localhost} {
 encode gzip
 log {
  format filter {
   wrap json
   fields {
    request>uri delete
    request>headers delete
    resp_headers delete
   }
  }
 }
 handle /api/* {
  header Cache-Control no-store
  @publicSocket {
   path /api/locations/* /api/sync/*
   header Upgrade websocket
   header Origin https://{$PUBLIC_TRAVELMAP_HOST:localhost}
  }
  request_header @publicSocket Host {$PUBLIC_TRAVELMAP_HOST:localhost}
  reverse_proxy api:3001
 }
 handle {
  root * /srv
  try_files {path} /index.html
  file_server
 }
}
