DATABASE_URL=postgresql://travelmap:change-me@localhost:5432/travelmap
PORT=3001
NODE_ENV=development
# Optional HTTP proxy for outbound geocoder requests only
GEOCODER_PROXY=
# OSRM route service prefixes, one per prepared transport profile.
ROUTE_WALK_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving
ROUTE_DRIVE_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
ROUTE_BIKE_URL=https://routing.openstreetmap.de/routed-bike/route/v1/driving
# ROUTE_PROXY defaults to GEOCODER_PROXY if omitted.
AMAP_WEB_SERVICE_KEY=
